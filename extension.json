{
	"name": "ExportForTranslation",
	"version": "1.0.0",
	"author": [
		"Dror S. [FFS] ([https://www.kolzchut.org.il Kol-Zchut])"
	],
	"url": "https://github.com/kolzchut/mediawiki-extensions-ExportForTranslation",
	"descriptionmsg": "exportfortranslation-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.35.0",
		"extensions": {
			"TranslationManager": ">= 0.9.0"
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\ExportForTranslation\\": "src/"
	},
	"AvailableRights": [
		"export-for-translation"
	],
	"GroupPermissions": {
		"translator": {
			"export-for-translation": true
		}
	},
	"ConfigRegistry": {
		"ExportForTranslation": "GlobalVarConfig::newInstance"
	},
	"config": {
		"ExportForTranslationNamespaces": {
			"value": [
				0
			]
		},
		"ExportForTranslationDefaultLanguage": {
			"value": "ar"
		}
	},
	"ExtensionMessagesFiles": {
		"ExportForTranslationAlias": "ExportForTranslation.i18n.alias.php"
	},
	"HookHandlers": {
		"ExportForTranslationHooks": {
			"class": "MediaWiki\\Extension\\ExportForTranslation\\Hooks",
			"services": [
				"MainConfig"
			]
		}
	},
	"Hooks": {
		"SkinTemplateNavigation::Universal": "ExportForTranslationHooks"
	},
	"MessagesDirs": {
		"ExportForTranslation": [
			"i18n"
		]
	},
	"ServiceWiringFiles": [
		"src/ServiceWiring.php"
	],
	"SpecialPages": {
		"ExportForTranslation": {
			"class": "MediaWiki\\Extension\\ExportForTranslation\\SpecialExportForTranslation",
			"services": [
				"ExportForTranslation.Exporter"
			]
		}
	},
	"manifest_version": 2
}
